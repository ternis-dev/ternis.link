APP_NAME="ternis.link"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=https://href.nz

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=ternis_link
# DB_USERNAME=ternis
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=sync
CACHE_STORE=database

# Long random secret mixed into stored IP hashes (guest quotas, unique
# visitors). Empty = plain SHA-256. Set once: rotating orphans old linkage.
# IP_HASH_PEPPER=change-me-to-64-random-hex-chars

# Encrypted short-retention IP capture for abuse forensics (hashed IPs
# stay regardless). Empty retention uses 30 days; false disables capture.
# IP_CAPTURE_ENABLED=true
# IP_RETENTION_DAYS=30

# Redis (cache + queue for production)
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# Ternis Auth SSO
TERNIS_AUTH_BASE_URL=https://auth.ternis.net
TERNIS_AUTH_CLIENT_ID=
TERNIS_AUTH_CLIENT_SECRET=
TERNIS_AUTH_REDIRECT_URI=https://dash.ternis.link/auth/callback
TERNIS_AUTH_SCOPES="openid profile email ternis:sso ternis:member ternis:customer ternis:partner"

# Avatar CDN
TERNIS_AVATAR_BASE_URL=https://user.t-api.de

# Domain config
DOMAIN_PUBLIC=href.nz
DOMAIN_BUSINESS=href.re
DOMAIN_TERNIS=ternis.link
DOMAIN_DASHBOARD=dash.ternis.link
DOMAIN_ADMIN=admin.ternis.link
DOMAIN_API=links.t-api.de

# ==========================================================
# Production overrides — set these on the server (do NOT
# commit real values). Local dev keeps the sqlite/sync
# defaults above.
# ==========================================================
# APP_ENV=production
# APP_DEBUG=false
# LOG_LEVEL=warning
#
# Behind Caddy HTTPS, cookies must be Secure:
# SESSION_SECURE_COOKIE=true
# SESSION_DOMAIN=.ternis.link
#
# Caddy proxies to PHP-FPM: trust it so $request->ip()
# reflects the real client (IP-hash analytics + throttling).
# TRUSTED_PROXIES=*
#
# Database (PostgreSQL recommended):
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=ternis_link
# DB_USERNAME=ternis
# DB_PASSWORD=
#
# Redis-backed queue/cache/session for the RecordClick
# pipeline and SSO token cache:
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
#
# RP-initiated logout at Ternis Auth after local logout:
# TERNIS_AUTH_END_SESSION=true
