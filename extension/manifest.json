{
  "manifest_version": 3,
  "name": "ternis.link Shortener",
  "version": "1.0.0",
  "description": "Shorten the current tab with ternis.link — guest mode or your own API key, custom slugs, QR codes.",
  "homepage_url": "https://ternis.link/pages/extension",
  "minimum_chrome_version": "109",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shorten with ternis.link",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "contextMenus", "activeTab", "notifications"],
  "host_permissions": ["https://links.t-api.de/*", "https://href.nz/*"],
  "omnibox": { "keyword": "tl" }
}
